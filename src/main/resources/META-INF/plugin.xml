<idea-plugin>
    <id>dev.appelflap.color-scheme-per-language</id>
    <name>Color Scheme per Language</name>
    <vendor>appelflap</vendor>
    <!-- description is injected by patchPluginXml from the marked README.md section. -->

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="dev.appelflap.colorschemeperlanguage.settings.ColorSchemeConfigurable"
                id="dev.appelflap.colorschemeperlanguage.settings.ColorSchemeConfigurable"
                displayName="Color Scheme per Language"/>
        <diff.DiffExtension implementation="dev.appelflap.colorschemeperlanguage.diff.DiffColorSchemeExtension"/>
        <editorFactoryListener implementation="dev.appelflap.colorschemeperlanguage.runtime.ColorSchemeCreationListener"/>
    </extensions>

    <applicationListeners>
        <listener
                class="dev.appelflap.colorschemeperlanguage.runtime.GlobalSchemeChangeListener"
                topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
    </applicationListeners>

    <projectListeners>
        <listener
                class="dev.appelflap.colorschemeperlanguage.runtime.ColorSchemeSelectionListener"
                topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
